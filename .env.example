# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN upload .env ke GitHub (sudah ada di .gitignore).

# Akun Gmail untuk membaca link verifikasi (App Password, bukan password biasa)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Domain email untuk akun yang dibuat
DOMAIN=

# true = browser tidak terlihat (disarankan untuk jalan di VPS / nonton)
HEADLESS=true

# Dashboard 9Router (mode 2 & 4)
ROUTER_URL=
ROUTER_PASSWORD=

# Opsional: notifikasi Telegram ke grup/topik (mode 1 & 2).
# Kosongkan kalau tidak dipakai, batch tetap jalan tanpa notifikasi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
TELEGRAM_NOTIF=true

# Opsional: proxy tunggal. Kosongkan kalau pakai proxies.txt
PROXY=
